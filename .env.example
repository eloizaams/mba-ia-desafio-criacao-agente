# Copie para .env e preencha. O .env NÃO vai para o Git.

# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Usa a API do AI Studio (não Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Modelos Gemini por papel (escolhidos no spike da Fase 2; consulte os modelos
# disponíveis e os limites do seu projeto no Google AI Studio)
AURORA_MODELO_PRINCIPAL=gemini-2.5-flash
AURORA_MODELO_ESPECIALISTA=gemini-2.5-flash

# Caminho do banco SQLite (dados do condomínio e sessões ADK)
AURORA_DB_PATH=aurora.db
