# Copie para .env e preencha. O .env NÃO vai para o Git.
# Só nomes de variáveis aqui: nenhum valor versionado.

# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# true/false: FALSE usa a API do AI Studio (não Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=

# Modelos Gemini por papel. Padrão do projeto: gemini-3.5-flash-lite nos dois, que
# passou o fluxo completo em execução real. Alternativa: gemini-3.5-flash.
# Se vier 503 ("high demand"), troque aqui: é oscilação de capacidade do Google, não
# erro de código. A série 2.5 está legada; Pro só existe em preview.
# Ver docs/ADK-CONFIRMACAO.md e DESAFIOS.md.
AURORA_MODELO_PRINCIPAL=
AURORA_MODELO_ESPECIALISTA=

# Caminho do banco SQLite (dados do condomínio e sessões ADK)
AURORA_DB_PATH=
