# Copie para .env e preencha. O .env NÃO vai para o Git.
# Só nomes de variáveis aqui: nenhum valor versionado.

# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# true/false: FALSE usa a API do AI Studio (não Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=

# Nomes dos modelos Gemini por papel (escolhidos no spike da Fase 2)
AURORA_MODELO_PRINCIPAL=
AURORA_MODELO_ESPECIALISTA=

# Caminho do banco SQLite (dados do condomínio e sessões ADK)
AURORA_DB_PATH=
